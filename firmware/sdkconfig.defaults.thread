# Matter over Thread (IEEE 802.15.4) -- the supported configuration.
#
# The ESP32-C6 has a native 802.15.4 radio whose TX peak sits comfortably inside
# the budget of the board's 3V3 LDO (U3, MCP1700, 250 mA). This is the only radio
# this hardware revision can actually power; see sdkconfig.defaults.wifi.
#
# Apply on top of the common + C6 defaults:
#   -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.thread"

# Enable OpenThread
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_SRP_CLIENT=y
CONFIG_OPENTHREAD_DNS_CLIENT=y
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_NOTE=y
CONFIG_OPENTHREAD_CLI=n

# Disable Wi-Fi (Thread-only device). ENABLE_WIFI_AP duplicates the common
# sdkconfig.defaults; kept so this overlay fully describes the radio on its own.
CONFIG_ENABLE_WIFI_STATION=n
CONFIG_ENABLE_WIFI_AP=n

# Disable lwip ipv6 autoconfig (addresses managed by OpenThread)
CONFIG_LWIP_IPV6_AUTOCONFIG=n

# LwIP config for OpenThread
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
